digraph SecurityFramework {
    rankdir=TB;
    node [shape=box, style=rounded, fontname="Arial", margin="0.3,0.1"];
    edge [fontname="Arial"];

    // Main Components (Updated for 2025-2026)
    Strategy [label="Strategic Security Vision\n(NIST CSF 2.0)", style=filled, fillcolor=lightblue];
    Principles [label="Foundational Principles\n(Zero Trust + AI Security)"];
    Architecture [label="Security Architecture\n(Cloud-Native)"];
    Controls [label="Security Controls\n(Policy-as-Code)"];
    ThreatMgmt [label="AI-Enhanced Threat\nManagement"];
    Tech [label="Advanced Technologies\n(LLM Security)"];
    Compliance [label="Compliance & Governance\n(AI Act + PCI-DSS 4.0)"];
    Metrics [label="Security Metrics\n(AI-Driven Analytics)"];
    
    // Enhanced Subcomponents for 2025-2026
    node [shape=box, style="rounded,filled", fillcolor=lightgrey];
    IAM [label="Identity & Access\nManagement\n(Passwordless)"];
    Network [label="Network Security\n(SASE/SSE)"];
    Data [label="Data Protection\n(Quantum-Ready)"];
    ML [label="Machine Learning\n(Adversarial Protection)"];
    AI [label="AI Security Framework\n(LLM Governance)"];
    SOC [label="Security Operations\n(AI-Powered SOC)"];
    Supply [label="Supply Chain\n(SBOM/SLSA)"];
    
    // Relationships
    Strategy -> {Principles, Architecture, Controls} [dir=forward];
    Principles -> {IAM, Network, Data, Supply} [dir=forward];
    Architecture -> {IAM, Network, Data, Supply} [dir=forward];
    Controls -> ThreatMgmt [dir=forward];
    ThreatMgmt -> {SOC, ML, AI} [dir=forward];
    {ML, AI} -> Metrics [dir=forward];
    {IAM, Network, Data, Supply} -> Compliance [dir=forward];
    
    // Enhanced Metrics Subgraph
    subgraph cluster_metrics {
        style=dashed;
        label="2025-2026 KPIs";
        MTTD [label="AI-Enhanced\nMTTD"];
        MTTR [label="Automated\nMTTR"];
        Risk [label="Risk Mitigation\nEffectiveness"];
        AIGov [label="AI Governance\nScore"];
        Metrics -> {MTTD, MTTR, Risk, AIGov} [dir=forward];
    }

    // Add invisible edges to improve layout
    edge [style=invis];
    IAM -> Network -> Data -> Supply;
    ML -> AI;
}
